USAGE:

RESULTS_FOLDER="results"

# Step 1: Run simulation
python run_simulation.py --config_dir=configs --n_users=250 --output_dir={RESULTS_FOLDER}

# Step 2: Run postprocessing (NEW UNIFIED PIPELINE)
# This replaces: LLM_judge.py, convert_emojiis.py, build_validation_data.py
python run_postprocessing.py --input_dir={RESULTS_FOLDER}/results_bluesky --dataset bluesky
python run_postprocessing.py --input_dir={RESULTS_FOLDER}/results_twitter --dataset twitter
python run_postprocessing.py --input_dir={RESULTS_FOLDER}/results_reddit --dataset reddit

# Benefits of new pipeline:
# - Single command instead of 5 separate scripts
# - Reduces ~40 files per config to 3-5 files per dataset
# - Eliminates data duplication
# - Configurable via pipeline_config.yaml

# Step 3: Run validation and analysis (TODO: integrate into unified pipeline)
python validation/validate_text.py --input_dir={RESULTS_FOLDER}_consolidated --validation=all
python validation/features_analysis.py compute_features {RESULTS_FOLDER}_consolidated
python validation/features_analysis.py evaluate {RESULTS_FOLDER}_consolidated labels

# Step 4: Generate plots
python plotting/generate_SOTA_plots.py {RESULTS_FOLDER}_consolidated
python plotting/generate_config_optimal_plots.py {RESULTS_FOLDER}_consolidated

